DATABASE_URL=postgresql://user:password@localhost:5432/nom_de_votre_base_de_données

# Compte administrateur (créé par le script de seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="mot de passe sécurisé"

PORT=4000

JWT_SECRET="votre-clé-secrète-jwt-très-sécurisée"

# Origine(s) autorisée(s) du frontend, séparées par des virgules.
# Obligatoire avec le cookie d'authentification : « * » est refusé par le navigateur.
CORS_ORIGINE="http://localhost:3000"

# Cookie d'authentification (httpOnly).
# lax  : front et API sur le même domaine enregistrable (app.exemple.fr / api.exemple.fr, localhost)
# none : front et API sur deux sites distincts (sous-domaines *.up.railway.app) — impose Secure
COOKIE_SAMESITE="lax"
# À passer à true en production derrière HTTPS (automatique si COOKIE_SAMESITE=none)
COOKIE_SECURE="false"

# Base des liens de confirmation et de réinitialisation envoyés par e-mail
URL_FRONTEND="http://localhost:3000"

S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="la clé d'accès"
S3_SECRET_ACCESS_KEY="la clé secrète"
S3_BUCKET="nom-de-votre-bucket"
S3_REGION="auto"

SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=port SMTP (souvent 587 ou 465)
SMTP_USER="le login SMTP affiché"
SMTP_PASS="la clé SMTP"
EMAIL_EXPEDITEUR="EDLoc <ton-adresse-verifiee@exemple.fr>"